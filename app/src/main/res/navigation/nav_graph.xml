<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/bienvenidaFragment">

    <fragment
        android:id="@+id/bienvenidaFragment"
        android:name="com.example.app.fragments.BienvenidaFragment"
        android:label="Bienvenida"
        tools:layout="@layout/fragment_bienvenida">
        <action
            android:id="@+id/action_bienvenida_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_bienvenida_to_registro"
            app:destination="@id/registroFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.app.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_registro"
            app:destination="@id/registroFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_recuperacion"
            app:destination="@id/recuperacionFragment" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.app.fragments.RegistroFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_registro">
        <action
            android:id="@+id/action_registro_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registroFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/recuperacionFragment"
        android:name="com.example.app.fragments.RecuperacionFragment"
        android:label="Recuperación"
        tools:layout="@layout/fragment_recuperacion" />
</navigation>
